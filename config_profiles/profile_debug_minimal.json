{
  "mcpServers": {
    "archi-mcp": {
      "command": "uv",
      "args": ["run", "--directory", "/Users/patrik/Projects/archi-mcp", "python", "-m", "archi_mcp.server"],
      "cwd": "/Users/patrik/Projects/archi-mcp",
      "env": {
        "ARCHI_MCP_LOG_LEVEL": "DEBUG",
        "ARCHI_MCP_STRICT_VALIDATION": "false",
        
        "ARCHI_MCP_DEFAULT_DIRECTION": "horizontal",
        "ARCHI_MCP_DEFAULT_SHOW_LEGEND": "false",
        "ARCHI_MCP_DEFAULT_SHOW_TITLE": "false",
        "ARCHI_MCP_DEFAULT_GROUP_BY_LAYER": "false",
        "ARCHI_MCP_DEFAULT_SPACING": "compact",
        
        "ARCHI_MCP_DEFAULT_LANGUAGE": "en",
        "ARCHI_MCP_AUTO_DETECT_LANGUAGE": "false",
        
        "ARCHI_MCP_GENERATE_PNG": "true",
        "ARCHI_MCP_GENERATE_SVG": "false",
        "ARCHI_MCP_PNG_QUALITY": "normal",
        
        "ARCHI_MCP_EXPORT_FORMAT": "minimal",
        "ARCHI_MCP_CLEANUP_EXPORTS": "false",
        
        "ARCHI_MCP_PLANTUML_VALIDATION": "basic"
      }
    }
  }
}