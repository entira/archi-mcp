@startuml
!include <archimate/Archimate>

title Apple Pay - Motivačno-strategický pohľad

' Description: ArchiMate diagram zobrazujúci strategické ciele, motivácie a schopnosti Apple Pay ekosystému


package "Motivation Layer" {
  Motivation_Stakeholder(apple, "Apple Inc.")
  Motivation_Stakeholder(banks, "Banky a finančné inštitúcie")
  Motivation_Stakeholder(merchants, "Obchodníci")
  Motivation_Stakeholder(customers, "Zákazníci")
  Motivation_Driver(digital_transformation, "Digitálna transformácia platieb")
  Motivation_Driver(security_concerns, "Bezpečnostné obavy")
  Motivation_Driver(user_convenience, "Požiadavka na pohodlie")
  Motivation_Goal(market_share, "Zvýšenie trhového podielu")
  Motivation_Goal(secure_payments, "Zabezpečené platby")
  Motivation_Goal(seamless_experience, "Bezproblémová používateľská skúsenosť")
  Motivation_Goal(ecosystem_growth, "Rast ekosystému")
  Motivation_Outcome(customer_trust, "Dôvera zákazníkov")
  Motivation_Outcome(adoption_rate, "Vysoká miera adopcie")
  Motivation_Outcome(revenue_growth, "Rast príjmov")
}

package "Strategy Layer" {
  Strategy_Capability(mobile_payment_cap, "Schopnosť mobilných platieb")
  Strategy_Capability(biometric_auth_cap, "Biometrická autentifikácia")
  Strategy_Capability(tokenization_cap, "Tokenizácia")
  Strategy_Resource(nfc_resource, "NFC technológia")
  Strategy_Resource(secure_element, "Secure Element")
  Strategy_Resource(wallet_app, "Wallet aplikácia")
  Course of action(expansion_strategy, "Geografická expanzia")
  Course of action(partnership_strategy, "Strategické partnerstvá")
  Course of action(innovation_strategy, "Kontinuálna inovácia")
}


' Relationships
Rel_Association(apple, market_share, "má cieľ")
Rel_Association(apple, ecosystem_growth, "sleduje")
Rel_Association(banks, secure_payments, "požaduje")
Rel_Association(merchants, seamless_experience, "potrebuje")
Rel_Association(customers, seamless_experience, "očakáva")
Rel_Association(customers, secure_payments, "vyžaduje")
Rel_Influence(digital_transformation, market_share, "motivuje")
Rel_Influence(security_concerns, secure_payments, "vedie k")
Rel_Influence(user_convenience, seamless_experience, "podporuje")
Rel_Realization(market_share, revenue_growth, "dosahuje")
Rel_Realization(secure_payments, customer_trust, "buduje")
Rel_Realization(seamless_experience, adoption_rate, "zvyšuje")
Rel_Realization(mobile_payment_cap, seamless_experience, "umožňuje")
Rel_Realization(biometric_auth_cap, secure_payments, "zabezpečuje")
Rel_Realization(tokenization_cap, secure_payments, "chráni")
Rel_Assignment(nfc_resource, mobile_payment_cap, "podporuje")
Rel_Assignment(secure_element, tokenization_cap, "implementuje")
Rel_Assignment(wallet_app, mobile_payment_cap, "poskytuje")
Rel_Realization(expansion_strategy, market_share, "napĺňa")
Rel_Realization(partnership_strategy, ecosystem_growth, "podporuje")
Rel_Realization(innovation_strategy, seamless_experience, "zlepšuje")

' Legend
legend right
  Motivation Layer
  Strategy Layer
end legend

@enduml