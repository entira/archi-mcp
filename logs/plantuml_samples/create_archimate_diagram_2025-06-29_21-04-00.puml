@startuml
!include <archimate/Archimate>

title Apple Pay - Motivational and Strategic View

' Description: Strategic goals, motivations and capabilities of Apple Pay ecosystem


package "Motivation Layer" {
  Motivation_Stakeholder(apple, "Apple Inc.")
  Motivation_Stakeholder(banks, "Banks")
  Motivation_Stakeholder(merchants, "Merchants")
  Motivation_Stakeholder(customers, "Customers")
  Motivation_Driver(digital_trend, "Digital Payment Transformation")
  Motivation_Driver(security_need, "Security Concerns")
  Motivation_Driver(convenience, "User Convenience Demand")
  Motivation_Goal(market_goal, "Market Share Growth")
  Motivation_Goal(security_goal, "Secure Payments")
  Motivation_Goal(experience_goal, "Seamless Experience")
  Motivation_Goal(ecosystem_goal, "Ecosystem Growth")
  Motivation_Outcome(trust_outcome, "Customer Trust")
  Motivation_Outcome(adoption_outcome, "High Adoption Rate")
  Motivation_Outcome(revenue_outcome, "Revenue Growth")
}

package "Strategy Layer" {
  Strategy_Capability(mobile_cap, "Mobile Payment Capability")
  Strategy_Capability(biometric_cap, "Biometric Authentication")
  Strategy_Capability(token_cap, "Tokenization")
  Strategy_Resource(nfc_tech, "NFC Technology")
  Strategy_Resource(secure_elem, "Secure Element")
  Strategy_Resource(wallet_app, "Wallet App")
  Course of action(expansion, "Geographic Expansion")
  Course of action(partnerships, "Strategic Partnerships")
  Course of action(innovation, "Continuous Innovation")
}


' Relationships
Rel_Association(apple, market_goal, "pursues")
Rel_Association(apple, ecosystem_goal, "targets")
Rel_Association(banks, security_goal, "requires")
Rel_Association(merchants, experience_goal, "needs")
Rel_Association(customers, experience_goal, "expects")
Rel_Association(customers, security_goal, "demands")
Rel_Influence(digital_trend, market_goal, "drives")
Rel_Influence(security_need, security_goal, "creates")
Rel_Influence(convenience, experience_goal, "supports")
Rel_Realization(market_goal, revenue_outcome, "achieves")
Rel_Realization(security_goal, trust_outcome, "builds")
Rel_Realization(experience_goal, adoption_outcome, "increases")
Rel_Realization(mobile_cap, experience_goal, "enables")
Rel_Realization(biometric_cap, security_goal, "ensures")
Rel_Realization(token_cap, security_goal, "protects")
Rel_Assignment(nfc_tech, mobile_cap, "supports")
Rel_Assignment(secure_elem, token_cap, "implements")
Rel_Assignment(wallet_app, mobile_cap, "provides")
Rel_Realization(expansion, market_goal, "fulfills")
Rel_Realization(partnerships, ecosystem_goal, "supports")
Rel_Realization(innovation, experience_goal, "improves")

' Legend
legend right
  Motivation Layer
  Strategy Layer
end legend

@enduml