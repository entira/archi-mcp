@startuml
!include <archimate/Archimate>

title Apple Pay - Biznis procesy a implementácia

' Description: Biznis procesy a implementácia stratégie Apple Pay

left to right direction

package "Business Layer" {
  Business_Process(platobny_proces, "Proces mobilnej platby")
  Business_Process(autentifikacny_proces, "Proces biometrickej autentifikácie")
  Business_Process(tokenizacny_proces, "Proces tokenizácie")
  Business_Process(registracny_proces, "Proces registrácie karty")
  Business_Service(apple_pay_service, "Apple Pay služba")
  Business_Service(bezpecnostna_sluzba, "Bezpečnostná služba")
}

package "Implementation Layer" {
  Implementation_Work_Package(geograficka_expanzia, "Geografická expanzia")
  Implementation_Deliverable(partnerske_zmluvy, "Uzatvorené partnerstvá")
  Implementation_Deliverable(nova_funkcionalita, "Nová funkcionalita")
  Implementation_Work_Package(strategicke_partnerstva, "Program partnerstiev")
  Implementation_Work_Package(inovacny_program, "Inovačný program")
}


' Relationships
Rel_Realization(platobny_proces, apple_pay_service, "realization")
Rel_Realization(autentifikacny_proces, bezpecnostna_sluzba, "realization")
Rel_Realization(tokenizacny_proces, bezpecnostna_sluzba, "realization")
Rel_Realization(registracny_proces, apple_pay_service, "realization")
Rel_Serving(bezpecnostna_sluzba, apple_pay_service, "serving")
Rel_Triggering(autentifikacny_proces, platobny_proces, "triggering")
Rel_Triggering(platobny_proces, tokenizacny_proces, "triggering")
Rel_Realization(geograficka_expanzia, apple_pay_service, "rozširuje")
Rel_Realization(strategicke_partnerstva, partnerske_zmluvy, "realization")
Rel_Realization(inovacny_program, nova_funkcionalita, "realization")
Rel_Serving(partnerske_zmluvy, apple_pay_service, "umožňujú")
Rel_Serving(nova_funkcionalita, apple_pay_service, "rozširujú")

' Legend
legend right
  Business Layer
  Implementation Layer
end legend

@enduml