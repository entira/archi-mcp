@startuml
!include <archimate/Archimate>

title ArchiMate Metamodel - Reflexívne modelovanie

' Description: ArchiMate metamodel namodelovaný pomocou samotného ArchiMate


package "Application Layer" {
  Applicationcomponent(archimate_framework, "ArchiMate Framework")
  Applicationcomponent(business_layer_component, "Business Layer")
  Applicationcomponent(application_layer_component, "Application Layer")
  Applicationcomponent(technology_layer_component, "Technology Layer")
  Applicationcomponent(motivation_extension, "Motivation Extension")
  Applicationcomponent(strategy_extension, "Strategy Extension")
  Applicationcomponent(implementation_migration, "Implementation & Migration")
  Applicationfunction(active_structure_aspects, "Active Structure Aspects")
  Applicationfunction(behavior_aspects, "Behavior Aspects")
  Applicationfunction(passive_structure_aspects, "Passive Structure Aspects")
  Application_DataObject(relationships_repository, "Relationships Repository")
  Application_DataObject(structural_relationships, "Structural Relationships")
  Application_DataObject(dynamic_relationships, "Dynamic Relationships")
  Application_DataObject(dependency_relationships, "Dependency Relationships")
  Application_DataObject(other_relationships, "Other Relationships")
}

package "Business Layer" {
  Businessprocess(metamodel_governance, "Metamodel Governance")
  Businessobject(archimate_standard, "ArchiMate Standard")
}

package "Technology Layer" {
  Technologyservice(tool_implementation, "Tool Implementation")
}


' Relationships
Rel_Composition(archimate_framework, business_layer_component, "composition")
Rel_Composition(archimate_framework, application_layer_component, "composition")
Rel_Composition(archimate_framework, technology_layer_component, "composition")
Rel_Composition(archimate_framework, motivation_extension, "composition")
Rel_Composition(archimate_framework, strategy_extension, "composition")
Rel_Composition(archimate_framework, implementation_migration, "composition")
Rel_Realization(business_layer_component, active_structure_aspects, "realization")
Rel_Realization(application_layer_component, active_structure_aspects, "realization")
Rel_Realization(technology_layer_component, active_structure_aspects, "realization")
Rel_Realization(business_layer_component, behavior_aspects, "realization")
Rel_Realization(application_layer_component, behavior_aspects, "realization")
Rel_Realization(technology_layer_component, behavior_aspects, "realization")
Rel_Realization(business_layer_component, passive_structure_aspects, "realization")
Rel_Realization(application_layer_component, passive_structure_aspects, "realization")
Rel_Realization(technology_layer_component, passive_structure_aspects, "realization")
Rel_Aggregation(relationships_repository, structural_relationships, "aggregation")
Rel_Aggregation(relationships_repository, dynamic_relationships, "aggregation")
Rel_Aggregation(relationships_repository, dependency_relationships, "aggregation")
Rel_Aggregation(relationships_repository, other_relationships, "aggregation")
Rel_Access(archimate_framework, relationships_repository, "access")
Rel_Realization(metamodel_governance, archimate_standard, "realization")
Rel_Realization(archimate_standard, archimate_framework, "realization")
Rel_Serving(tool_implementation, archimate_framework, "serving")

' Legend
legend right
  Application Layer
  Business Layer
  Technology Layer
end legend

@enduml