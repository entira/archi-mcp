@startuml
!include <archimate/Archimate>

title Apple Pay Security & Risk Architecture

' Description: Security and risk management components of Apple Pay


package "Application Layer" {
  Data object(token_vault, "Token Vault")
  Data object(device_account, "Device Account Number")
  Application process(tokenization, "Tokenization Process")
  Application process(auth_process, "Authentication Process")
  Application service(risk_engine, "Risk Assessment")
  Application service(fraud_monitor, "Fraud Monitoring")
  Data object(audit_log, "Audit Trail")
}

package "Technology Layer" {
  Technology_Device(secure_chip, "Secure Element Chip")
  System software(biometric_system, "Biometric System")
  Technology service(encryption, "Encryption Service")
  Communication network(network_layer, "Secure Network")
}

package "Business Layer" {
  Business process(compliance, "Compliance Management")
  Business function(security_ops, "Security Operations")
  Business policy(risk_policy, "Risk Management Policy")
  Contract(privacy_policy, "Privacy Policy")
}


' Relationships
Rel_Assignment(secure_chip, device_account, "stores")
Rel_Access(tokenization, token_vault, "creates")
Rel_Serving(biometric_system, auth_process, "enables")
Rel_Triggering(auth_process, tokenization, "authorizes")
Rel_Serving(risk_engine, tokenization, "validates")
Rel_Flow(fraud_monitor, risk_engine, "feeds data")
Rel_Serving(encryption, network_layer, "secures")
Rel_Serving(network_layer, tokenization, "transports")
Rel_Access(tokenization, audit_log, "logs")
Rel_Serving(audit_log, compliance, "supports")
Rel_Influence(risk_policy, risk_engine, "guides")
Rel_Serving(compliance, security_ops, "informs")
Rel_Influence(privacy_policy, compliance, "governs")
Rel_Assignment(security_ops, fraud_monitor, "manages")
Rel_Association(token_vault, device_account, "links to")

' Legend
legend right
  Application Layer
  Business Layer
  Technology Layer
end legend

@enduml