@startuml
!include <archimate/Archimate>

title Layered Architecture View

' Description: Business, application and technology layers for Modernizácia IT infrastruktúry slovenskej zdravotníckej organizácie s implementáciou elektronických zdravotnýckych záznamov, telemedicíny a AI diagnostických nástrojov

top to bottom direction

' Elements
Actor(primary_user, "Healthcare Provider")
Service(core_business_service, "Patient Care Service")
Process(core_business_process, "Patient Treatment Process")
Object(business_data, "Medical Records Data")
Component(user_interface, "User Interface")
Component(api_gateway, "API Gateway")
Component(core_application, "Core Application")
Component(data_service, "Data Service")
DataObject(application_database, "Application Database")
Node(web_server, "Web Server")
Node(app_server, "Application Server")
Node(database_server, "Database Server")
Device(load_balancer, "Load Balancer")

' Relationships
Rel_Serving(primary_user, core_business_service, "serving")
Rel_Realization(core_business_service, core_business_process, "realization")
Rel_Association(core_business_process, business_data, "association")
Rel_Realization(user_interface, core_business_service, "realization")
Rel_Flow(user_interface, api_gateway, "flow")
Rel_Flow(api_gateway, core_application, "flow")
Rel_Flow(core_application, data_service, "flow")
Rel_Association(data_service, application_database, "association")
Rel_Realization(application_database, business_data, "realization")
Rel_Assignment(web_server, user_interface, "assignment")
Rel_Assignment(app_server, api_gateway, "assignment")
Rel_Assignment(app_server, core_application, "assignment")
Rel_Assignment(app_server, data_service, "assignment")
Rel_Assignment(database_server, application_database, "assignment")
Rel_Serving(load_balancer, web_server, "serving")

' Legend
legend right
  Application Layer
  Business Layer
  Technology Layer
end legend

@enduml