@startuml
!include <archimate/Archimate>

title Apple Pay - Komplexná Technology Layer

' Description: Detailná technologická architektúra Apple Pay systému


' Technology Layer
Technology_Device(secure_element, "Secure Element")
Technology_Device(secure_enclave, "Secure Enclave")
Technology_Device(nfc_controller, "NFC Controller")
Technology_Device(biometric_hw, "Biometric Hardware")
System software(ios_security, "iOS Security Framework")
System software(secure_boot, "Secure Boot Chain")
System software(sep_os, "SEP Operating System")
System software(crypto_core, "Cryptographic Core")
System software(keychain, "Keychain Services")
Technology service(aes_service, "AES Encryption")
Technology service(tls_service, "TLS/SSL Service")
Technology service(token_service, "Token Vault Service")
Technology service(key_mgmt, "Key Management")
Communication network(secure_network, "Secure Network Layer")
Communication network(nfc_protocol, "NFC Protocol Stack")
Technology_Node(api_gateway, "API Gateway")
Technology_Node(hsm_cluster, "HSM Cluster")
Technology_Node(data_center, "Apple Data Center")
Application_Artifact(payment_keys, "Payment Keys")
Application_Artifact(device_cert, "Device Certificates")


' Relationships
Rel_Serving(secure_element, token_service, "stores tokens")
Rel_Assignment(secure_enclave, biometric_hw, "processes")
Rel_Assignment(sep_os, secure_enclave, "runs on")
Rel_Composition(ios_security, keychain, "includes")
Rel_Realization(crypto_core, aes_service, "implements")
Rel_Access(nfc_controller, nfc_protocol, "uses")
Rel_Triggering(secure_boot, ios_security, "verifies")
Rel_Access(key_mgmt, payment_keys, "manages")
Rel_Serving(tls_service, secure_network, "secures")
Rel_Assignment(hsm_cluster, key_mgmt, "hosts")
Rel_Access(api_gateway, secure_network, "connects via")
Rel_Composition(data_center, hsm_cluster, "contains")
Rel_Access(keychain, device_cert, "stores")
Rel_Access(secure_element, payment_keys, "protects")
Rel_Serving(aes_service, token_service, "encrypts")

' Legend
legend right
  Technology Layer
end legend

@enduml