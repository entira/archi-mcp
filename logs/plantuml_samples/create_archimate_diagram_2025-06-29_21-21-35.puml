@startuml
!include <archimate/Archimate>

title Apple Pay - Strategicke schopnosti a ciele

' Description: Prepojenie strategickych schopnosti s motivacnymi cielmi

top to bottom direction

package "Motivation Layer" {
  Motivation_Goal(trhovy_podiel, "Zvysenie trhoveho podielu")
  Motivation_Goal(zabezpecene_platby, "Zabezpecene platby")
  Motivation_Goal(skusenost, "Bezproblemova skusenost")
}

package "Business Layer" {
  Function(mobilne_platby, "Schopnost mobilnych platieb")
  Function(biometria, "Biometricka autentifikacia")
  Function(tokenizacia, "Tokenizacia")
  Business_Process(expanzia, "Geograficka expanzia")
  Business_Process(partnerstva, "Strategicke partnerstva")
  Business_Process(inovacia, "Kontinualna inovacia")
}


' Relationships
Rel_Realization(mobilne_platby, skusenost, "realization")
Rel_Realization(biometria, zabezpecene_platby, "realization")
Rel_Realization(tokenizacia, zabezpecene_platby, "realization")
Rel_Realization(expanzia, trhovy_podiel, "realization")
Rel_Realization(partnerstva, trhovy_podiel, "realization")
Rel_Realization(inovacia, skusenost, "realization")

' Legend
legend right
  Business Layer
  Motivation Layer
end legend

@enduml