@startuml
!include <archimate/Archimate>

title Apple Pay - Motivacno-strategicky pohlad

' Description: ArchiMate diagram zobrazujuci strategicke ciele, motivacie a schopnosti Apple Pay ekosystemu


package "Motivation Layer" {
  Motivation_Stakeholder(apple, "Apple Inc.")
  Motivation_Stakeholder(banks, "Banky a financne institucie")
  Motivation_Stakeholder(merchants, "Obchodnici")
  Motivation_Stakeholder(customers, "Zakaznici")
  Motivation_Driver(digital_transformation, "Digitalna transformacia platieb")
  Motivation_Driver(security_concerns, "Bezpecnostne obavy")
  Motivation_Driver(user_convenience, "Poziadavka na pohodlie")
  Motivation_Goal(market_share, "Zvysenie trhoveho podielu")
  Motivation_Goal(secure_payments, "Zabezpecene platby")
  Motivation_Goal(seamless_experience, "Bezproblemova pouzivatelska skusenost")
  Motivation_Goal(ecosystem_growth, "Rast ekosystemu")
  Motivation_Outcome(customer_trust, "Dovera zakaznikov")
  Motivation_Outcome(adoption_rate, "Vysoka miera adopcie")
  Motivation_Outcome(revenue_growth, "Rast prijmov")
}

package "Strategy Layer" {
  Strategy_Capability(mobile_payment_cap, "Schopnost mobilnych platieb")
  Strategy_Capability(biometric_auth_cap, "Biometricka autentifikacia")
  Strategy_Capability(tokenization_cap, "Tokenizacia")
  Strategy_Resource(nfc_resource, "NFC technologia")
  Strategy_Resource(secure_element, "Secure Element")
  Strategy_Resource(wallet_app, "Wallet aplikacia")
  Course of action(expansion_strategy, "Geograficka expanzia")
  Course of action(partnership_strategy, "Strategicke partnerstva")
  Course of action(innovation_strategy, "Kontinualna inovacia")
}


' Relationships
Rel_Association(apple, market_share, "ma ciel")
Rel_Association(apple, ecosystem_growth, "sleduje")
Rel_Association(banks, secure_payments, "pozaduje")
Rel_Association(merchants, seamless_experience, "potrebuje")
Rel_Association(customers, seamless_experience, "ocakava")
Rel_Association(customers, secure_payments, "vyzaduje")
Rel_Influence(digital_transformation, market_share, "motivuje")
Rel_Influence(security_concerns, secure_payments, "vedie k")
Rel_Influence(user_convenience, seamless_experience, "podporuje")
Rel_Realization(market_share, revenue_growth, "dosahuje")
Rel_Realization(secure_payments, customer_trust, "buduje")
Rel_Realization(seamless_experience, adoption_rate, "zvysuje")
Rel_Realization(mobile_payment_cap, seamless_experience, "umoznuje")
Rel_Realization(biometric_auth_cap, secure_payments, "zabezpecuje")
Rel_Realization(tokenization_cap, secure_payments, "chrani")
Rel_Assignment(nfc_resource, mobile_payment_cap, "podporuje")
Rel_Assignment(secure_element, tokenization_cap, "implementuje")
Rel_Assignment(wallet_app, mobile_payment_cap, "poskytuje")
Rel_Realization(expansion_strategy, market_share, "naplna")
Rel_Realization(partnership_strategy, ecosystem_growth, "podporuje")
Rel_Realization(innovation_strategy, seamless_experience, "zlepsuje")

' Legend
legend right
  Motivation Layer
  Strategy Layer
end legend

@enduml