@startuml
!include <archimate/Archimate>

title Application Structure View

' Description: Detailed application components and interfaces for Comprehensive eHealth system supporting electronic health records, telemedicine, patient management, clinical workflows, and health information exchange between healthcare providers, patients, and regulatory bodies

left to right direction

' Elements
Application_Component(web_frontend, "Web Frontend")
Application_Component(mobile_app, "Mobile Application")
Interface(rest_api, "REST API")
Interface(graphql_api, "GraphQL API")
Application_Component(user_service, "User Management Service")
Application_Component(business_logic_service, "Business Logic Service")
Application_Component(notification_service, "Notification Service")
Application_DataObject(user_data, "User Data")
Application_DataObject(business_data_app, "Business Data")
Application_DataObject(audit_log, "Audit Log")

' Relationships
Rel_Serving(web_frontend, rest_api, "serving")
Rel_Serving(mobile_app, graphql_api, "serving")
Rel_Serving(rest_api, user_service, "serving")
Rel_Serving(rest_api, business_logic_service, "serving")
Rel_Serving(graphql_api, user_service, "serving")
Rel_Serving(graphql_api, business_logic_service, "serving")
Rel_Flow(business_logic_service, user_service, "flow")
Rel_Triggering(business_logic_service, notification_service, "triggering")
Rel_Association(user_service, user_data, "association")
Rel_Association(business_logic_service, business_data_app, "association")
Rel_Association(user_service, audit_log, "association")

' Legend
legend right
  Application Layer
end legend

@enduml