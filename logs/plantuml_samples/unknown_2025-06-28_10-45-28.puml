@startuml
!include <archimate/Archimate>

title Three-Tier Architecture

' Description: Classic three-tier architecture pattern with presentation, business logic, and data layers

top to bottom direction

' Elements
Application_Component(presentation_layer, "Presentation Layer")
Application_Component(business_logic_layer, "Business Logic Layer")
Application_Component(data_access_layer, "Data Access Layer")
Data_Object(database, "Database")

' Relationships
Rel_Serving_Down(presentation_layer, business_logic_layer, "serving_down")
Rel_Serving_Down(business_logic_layer, data_access_layer, "serving_down")
Rel_Access(data_access_layer, database, "access")

' Legend
legend right
  Application Layer
end legend

@enduml