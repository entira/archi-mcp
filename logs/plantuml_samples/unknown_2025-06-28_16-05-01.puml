Motivation_Stakeholder(stakeholder_mz, "Ministerstvo zdravotníctva")
Motivation_Stakeholder(stakeholder_poistovne, "Zdravotné poisťovne")
Motivation_Stakeholder(stakeholder_lekarne, "Lekárne")
