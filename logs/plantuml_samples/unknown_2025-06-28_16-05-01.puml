Rel_Realization(goal_centralny_register, req_sifrovanie_dat, "Centrálny register realizuje požiadavku na šifrovanie dát")
Rel_Realization(goal_elektronicka_komunikacia, req_hl7_standardy, "Elektronická komunikácia realizuje podporu HL7 štandardov")
Rel_Realization(goal_telemedicina, req_mobilna_aplikacia, "Telemedicínske služby realizujú mobilnú aplikáciu")
Rel_Realization(goal_pokrytie_100, req_integracia_existujucich, "100% pokrytie realizuje integráciu s existujúcimi systémami")
