Rel_Assignment(business_actor_specialista, business_role_poskytovatel_specializovanej, "Špecialista má rolu poskytovateľa špecializovanej starostlivosti")
Rel_Assignment(business_actor_admin_pracovnik, business_role_spravca_zdravotnych_dat, "Administratívny pracovník má rolu správcu zdravotných dát")
Rel_Assignment(business_actor_zdravotna_poistovna, business_role_schvalovatel_uhrad, "Zdravotná poisťovňa má rolu schvaľovateľa úhrad")

' Legend
legend right
  Business Layer
