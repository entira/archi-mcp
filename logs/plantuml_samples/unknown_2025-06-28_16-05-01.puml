Rel_Association(res_standardy_protokoly, cap_interoperabilita_systemov, "Štandardy a protokoly podporujú interoperabilitu systémov")
Rel_Association(res_bezpecnostne_certifikaty, cap_bezpecnost_ochrana_dat, "Bezpečnostné certifikáty podporujú ochranu dát")
Rel_Association(res_financne_prostriedky, cap_telemedicina, "Finančné prostriedky umožňujú telemedicínu")
