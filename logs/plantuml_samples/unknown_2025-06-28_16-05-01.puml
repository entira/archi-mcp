' Relationships
Rel_Association(stakeholder_1, driver_1, "association")
Rel_Influence(driver_1, goal_1, "influence")
Rel_Realization(goal_1, requirement_1, "realization")
Rel_Influence(principle_1, requirement_1, "influence")
Rel_Association(stakeholder_pacienti, driver_kvalita_zdravotnej_care, "Pacienti sú motivovaní potrebou kvalitinejšej zdravotnej starostlivosti")
Rel_Association(stakeholder_pacienti, driver_dostupnost_sluzieb, "Pacienti potrebujú lepšiu dostupnosť zdravotných služieb")
Rel_Association(stakeholder_mz, driver_digitalizacia, "Ministerstvo zdravotníctva riadi digitalizáciu zdravotníctva")
Rel_Association(stakeholder_poistovne, driver_znizenie_nakladov, "Zdravotné poisťovne chcú znižovať náklady na zdravotníctvo")
Rel_Association(stakeholder_lekari, driver_interoperabilita, "Lekári potrebujú interoperabilitu pre efektívnu prácu")
Rel_Association(stakeholder_regulatori, driver_bezpecnost_dat, "Regulátori dbajú o bezpečnosť pacientskych dát")
