@startuml
!include <archimate/Archimate>

title ArchiMate MCP Server - Motivation View

' Description: Stakeholders, drivers, goals and requirements driving the ArchiMate MCP Server development

top to bottom direction

' Elements
Motivation_Stakeholder(ai_developers, "AI Developers")
Motivation_Stakeholder(enterprise_architects, "Enterprise Architects")
Motivation_Stakeholder(claude_users, "Claude Desktop Users")
Motivation_Driver(automation_need, "Architecture Automation Need")
Motivation_Driver(archimate_compliance, "ArchiMate 3.2 Compliance")
Motivation_Goal(automated_modeling, "Enable Automated ArchiMate Modeling")
Motivation_Goal(claude_integration, "Seamless Claude Desktop Integration")
Motivation_Requirement(archimate_support, "Complete ArchiMate 3.2 Support")
Motivation_Requirement(plantuml_generation, "PlantUML Code Generation")
Motivation_Requirement(mcp_compliance, "MCP Protocol Compliance")
Motivation_Principle(ease_of_use, "Ease of Use")

' Relationships
Rel_Association(ai_developers, automation_need, "drives")
Rel_Association(enterprise_architects, archimate_compliance, "requires")
Rel_Influence(automation_need, automated_modeling, "motivates")
Rel_Influence(archimate_compliance, automated_modeling, "constrains")
Rel_Influence(claude_users, claude_integration, "demands")
Rel_Realization(automated_modeling, archimate_support, "requires")
Rel_Realization(automated_modeling, plantuml_generation, "requires")
Rel_Realization(claude_integration, mcp_compliance, "requires")
Rel_Influence(ease_of_use, automated_modeling, "guides")
Rel_Influence(ease_of_use, claude_integration, "guides")

' Legend
legend right
  Motivation Layer
end legend

@enduml