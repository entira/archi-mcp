@startuml
!include <archimate/Archimate>

title ArchiMate MCP Server - Layered Architecture

' Description: Business, Application and Technology layers

top to bottom direction

' Elements
Business_Role(ea_role, "Enterprise Architecture Role")
Business_Process(modeling_process, "Architecture Modeling Process")
Business_Service(diagram_service, "Diagram Generation Service")
Application_Component(mcp_server, "ArchiMate MCP Server")
Application_Component(archimate_engine, "ArchiMate Engine")
Application_Component(plantuml_generator, "PlantUML Generator")
Application_Component(validator, "ArchiMate Validator")
Application_Interface(mcp_interface, "MCP Protocol Interface")
Application_Service(archimate_service, "ArchiMate Modeling Service")
Technology_Node(python_runtime, "Python Runtime")
Technology_Artifact(plantuml_jar, "PlantUML JAR")
Technology_SystemSoftware(claude_desktop, "Claude Desktop")

' Relationships
Rel_Assignment(ea_role, mcp_server, "assignment")
Rel_Realization(modeling_process, archimate_service, "realization")
Rel_Realization(diagram_service, mcp_interface, "realization")
Rel_Composition(mcp_server, archimate_engine, "composition")
Rel_Composition(mcp_server, validator, "composition")
Rel_Composition(archimate_engine, plantuml_generator, "composition")
Rel_Assignment(mcp_server, mcp_interface, "assignment")
Rel_Assignment(archimate_engine, archimate_service, "assignment")
Rel_Realization(mcp_server, python_runtime, "realization")
Rel_Association(plantuml_generator, plantuml_jar, "association")
Rel_Serving(mcp_interface, claude_desktop, "serving")

' Legend
legend right
  Application Layer
  Business Layer
  Technology Layer
end legend

@enduml