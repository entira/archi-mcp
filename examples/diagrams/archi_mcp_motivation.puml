@startuml
!include <archimate/Archimate>

title ArchiMate MCP Server - Motivation View

' Description: Stakeholders, drivers, goals and requirements

top to bottom direction

' Elements
Motivation_Stakeholder(architect, "Enterprise Architect")
Motivation_Stakeholder(developer, "Software Developer")
Motivation_Stakeholder(claude_user, "Claude Desktop User")
Motivation_Driver(complexity, "Architecture Complexity")
Motivation_Driver(compliance, "ArchiMate Compliance")
Motivation_Driver(automation, "Modeling Automation")
Motivation_Goal(archimate_goal, "Enable ArchiMate Modeling")
Motivation_Goal(integration_goal, "Claude Integration")
Motivation_Goal(quality_goal, "High Quality Diagrams")
Motivation_Requirement(mcp_req, "MCP Protocol Support")
Motivation_Requirement(archimate_req, "ArchiMate 3.2 Support")
Motivation_Requirement(plantuml_req, "PlantUML Generation")

' Relationships
Rel_Association(architect, complexity, "association")
Rel_Association(developer, automation, "association")
Rel_Influence(claude_user, integration_goal, "influence")
Rel_Influence(complexity, archimate_goal, "influence")
Rel_Influence(compliance, quality_goal, "influence")
Rel_Influence(automation, integration_goal, "influence")
Rel_Realization(archimate_goal, mcp_req, "realization")
Rel_Realization(archimate_goal, archimate_req, "realization")
Rel_Realization(quality_goal, plantuml_req, "realization")

' Legend
legend right
  Motivation Layer
end legend

@enduml