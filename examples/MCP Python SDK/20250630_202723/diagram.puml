@startuml
!include <archimate/Archimate>

title MCP Python SDK - Monitoring and Observability

' Description: Comprehensive monitoring, logging, and observability for MCP operations

left to right direction

' Elements
Application_Component(app_component_metrics_collector, "Metrics Collection Agent")
Application_Component(app_component_log_aggregator, "Log Aggregation Service")
Application_Component(app_component_tracing_system, "Distributed Tracing System")
Application_Component(app_component_alerting_engine, "Intelligent Alerting Engine")
Application_Service(app_service_dashboard, "Observability Dashboard")
Application_Service(app_service_health_check, "Health Check Service")
Technology_Service(tech_service_prometheus, "Prometheus Metrics")
Technology_Service(tech_service_elasticsearch, "Elasticsearch Logs")
Application_DataObject(data_object_operational_metrics, "Operational Metrics Repository")
Application_Component(app_component_mcp_instrumentation, "MCP Instrumentation")

' Relationships
Rel_Serving(app_component_metrics_collector, app_component_mcp_instrumentation, "serving")
Rel_Serving(app_component_log_aggregator, app_component_mcp_instrumentation, "serving")
Rel_Serving(app_component_tracing_system, app_component_mcp_instrumentation, "serving")
Rel_Serving(app_component_metrics_collector, tech_service_prometheus, "serving")
Rel_Serving(app_component_log_aggregator, tech_service_elasticsearch, "serving")
Rel_Access(app_component_alerting_engine, data_object_operational_metrics, "access")
Rel_Serving(app_service_dashboard, tech_service_prometheus, "serving")
Rel_Serving(app_service_health_check, app_component_mcp_instrumentation, "serving")
Rel_Assignment(app_component_metrics_collector, data_object_operational_metrics, "assignment")

' Legend
legend right
  Application Layer
  Technology Layer
end legend

@enduml