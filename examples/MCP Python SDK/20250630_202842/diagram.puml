@startuml
!include <archimate/Archimate>

title MCP Python SDK - Threat Model View

' Description: Security threat analysis, detection, and response capabilities for MCP environment

left to right direction

' Elements
Business_Actor(business_actor_malicious_ai, "Malicious AI Agent")
Business_Actor(business_actor_insider_threat, "Malicious Insider")
Business_Actor(business_actor_external_attacker, "External Attacker")
Application_Component(app_component_threat_detection, "AI Threat Detection Engine")
Application_Component(app_component_behavior_analysis, "Behavioral Analysis System")
Application_Component(app_component_security_orchestration, "Security Orchestration Platform")
Application_Service(app_service_anomaly_detection, "Anomaly Detection Service")
Application_Service(app_service_incident_response, "Automated Incident Response")
Business_Object(business_object_threat_intelligence, "Threat Intelligence Database")
Application_Component(app_component_mcp_honeypot, "MCP Honeypot System")

' Relationships
Rel_Association(business_actor_malicious_ai, app_component_mcp_honeypot, "association")
Rel_Association(business_actor_insider_threat, app_component_security_orchestration, "association")
Rel_Association(business_actor_external_attacker, app_service_anomaly_detection, "association")
Rel_Serving(app_component_threat_detection, business_actor_malicious_ai, "serving")
Rel_Serving(app_component_behavior_analysis, business_actor_insider_threat, "serving")
Rel_Serving(app_service_incident_response, business_actor_external_attacker, "serving")
Rel_Access(app_component_threat_detection, business_object_threat_intelligence, "access")
Rel_Triggering(app_service_anomaly_detection, app_service_incident_response, "triggering")
Rel_Realization(app_component_security_orchestration, app_service_incident_response, "realization")

' Legend
legend right
  Application Layer
  Business Layer
end legend

@enduml