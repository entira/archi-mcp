@startuml
!include <archimate/Archimate>

title MCP Python SDK - Customer Journey Architecture

' Description: Customer experience and interaction patterns with MCP-enabled services

left to right direction

' Elements
Business_Actor(business_actor_customer, "Enterprise Customer")
Business_Actor(business_actor_support_agent, "Customer Support Agent")
Business_Service(business_service_ai_customer_support, "AI-Enhanced Customer Support")
Business_Service(business_service_self_service_portal, "Intelligent Self-Service Portal")
Business_Process(business_process_issue_resolution, "AI-Assisted Issue Resolution")
Business_Process(business_process_proactive_support, "Proactive Customer Outreach")
Application_Service(app_service_knowledge_base, "Intelligent Knowledge Base")
Application_Service(app_service_chatbot_platform, "Conversational AI Platform")
Business_Object(business_object_customer_profile, "AI-Enhanced Customer Profile")
Application_Component(app_component_sentiment_analysis, "Real-Time Sentiment Analysis")

' Relationships
Rel_Serving(business_actor_customer, business_service_self_service_portal, "serving")
Rel_Serving(business_actor_support_agent, business_service_ai_customer_support, "serving")
Rel_Triggering(business_service_ai_customer_support, business_process_issue_resolution, "triggering")
Rel_Realization(business_service_ai_customer_support, business_process_proactive_support, "realization")
Rel_Serving(business_service_self_service_portal, app_service_knowledge_base, "serving")
Rel_Serving(business_service_ai_customer_support, app_service_chatbot_platform, "serving")
Rel_Access(business_process_issue_resolution, business_object_customer_profile, "access")
Rel_Serving(app_component_sentiment_analysis, business_actor_customer, "serving")
Rel_Assignment(app_component_sentiment_analysis, business_object_customer_profile, "assignment")

' Legend
legend right
  Application Layer
  Business Layer
end legend

@enduml