@startuml
!include <archimate/Archimate>

title MCP Python SDK - Integration Architecture

' Description: Integration patterns and connectivity between MCP and existing enterprise systems

left to right direction

' Elements
Application_Component(app_component_enterprise_erp, "Enterprise ERP System")
Application_Component(app_component_crm_system, "CRM System")
Application_Component(app_component_hr_system, "HR Management System")
Application_Component(app_component_mcp_integration_hub, "MCP Integration Hub")
Application_Service(app_service_data_translation, "Data Translation Service")
Application_Service(app_service_protocol_adapter, "Protocol Adapter Service")
Application_Interface(app_interface_mcp_standard, "MCP Standard Interface")
Application_Interface(app_interface_rest_api, "REST API Interface")
Application_Interface(app_interface_soap_api, "SOAP API Interface")
Application_DataObject(data_object_integration_catalog, "Integration Catalog")

' Relationships
Rel_Serving(app_component_mcp_integration_hub, app_component_enterprise_erp, "serving")
Rel_Serving(app_component_mcp_integration_hub, app_component_crm_system, "serving")
Rel_Serving(app_component_mcp_integration_hub, app_component_hr_system, "serving")
Rel_Serving(app_component_mcp_integration_hub, app_service_data_translation, "serving")
Rel_Serving(app_component_mcp_integration_hub, app_service_protocol_adapter, "serving")
