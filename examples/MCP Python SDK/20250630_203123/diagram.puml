@startuml
!include <archimate/Archimate>

title MCP Python SDK - Skills and Training Architecture

' Description: Organizational capability development, training, and career progression for MCP adoption

left to right direction

' Elements
Business_Role(business_role_ai_architect, "AI Solution Architect")
Business_Role(business_role_mcp_developer, "MCP Integration Developer")
Business_Role(business_role_ai_operations, "AI Operations Specialist")
Business_Service(business_service_training_program, "MCP Training Program")
Business_Service(business_service_certification, "MCP Certification Program")
Application_Service(app_service_learning_platform, "Interactive Learning Platform")
Application_Service(app_service_hands_on_labs, "MCP Hands-On Labs")
Business_Object(business_object_skill_matrix, "MCP Skills Matrix")
Business_Object(business_object_career_pathway, "AI Career Development Path")
Business_Process(business_process_skill_assessment, "Skills Assessment Process")

' Relationships
Rel_Serving(business_service_training_program, business_role_ai_architect, "serving")
Rel_Serving(business_service_training_program, business_role_mcp_developer, "serving")
Rel_Serving(business_service_training_program, business_role_ai_operations, "serving")
Rel_Assignment(business_service_certification, business_role_mcp_developer, "assignment")
Rel_Realization(business_service_training_program, app_service_learning_platform, "realization")
Rel_Composition(app_service_learning_platform, app_service_hands_on_labs, "composition")
Rel_Assignment(business_object_skill_matrix, business_role_ai_architect, "assignment")
Rel_Influence(business_object_career_pathway, business_role_mcp_developer, "influence")
Rel_Access(business_process_skill_assessment, business_object_skill_matrix, "access")

' Legend
legend right
  Application Layer
  Business Layer
end legend

@enduml